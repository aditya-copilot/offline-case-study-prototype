# AI Service Configuration
VITE_AI_API_BASE_URL=https://grid.ai.juspay.net/v1
VITE_AI_API_KEY=your-api-key-here
VITE_AI_DEFAULT_MODEL=claude-sonnet-4-5
VITE_AI_FALLBACK_MODEL=kimi-latest

# Feature Flags
VITE_ENABLE_AI_RECOMMENDATIONS=true
VITE_ENABLE_VOICE_AI=true
VITE_ENABLE_AI_CACHING=true

# Voice Configuration
VITE_VOICE_LANGUAGE=en-IN
VITE_VOICE_AUTO_SPEAK=true
