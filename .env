# =============================================================================
# AI SERVICE CONFIGURATION - REQUIRED
# =============================================================================

# Base URL for Juspay AI Grid API
VITE_AI_API_BASE_URL=https://grid.ai.juspay.net/v1

# API Key for authentication (replace with your actual key)
VITE_AI_API_KEY=sk-your-api-key-here

# Default AI Model for recommendations and chat
VITE_AI_DEFAULT_MODEL=claude-sonnet-4-5

# Fallback model when primary is unavailable
VITE_AI_FALLBACK_MODEL=kimi-latest

# =============================================================================
# APPLICATION CONFIGURATION - REQUIRED
# =============================================================================

# Environment: development, staging, production
VITE_APP_ENV=development

# Backend API URL
VITE_API_URL=http://localhost:3001/api

# WebSocket URL for real-time features
VITE_WS_URL=ws://localhost:3001/ws

# =============================================================================
# FEATURE FLAGS - OPTIONAL
# =============================================================================

# Enable AI recommendations feature
VITE_FEATURE_AI=true

# Enable BLE (Bluetooth Low Energy) features
VITE_FEATURE_BLE=false

# Enable analytics tracking
VITE_FEATURE_ANALYTICS=true

# Enable push notifications
VITE_FEATURE_PUSH=false

# Enable background sync
VITE_FEATURE_SYNC=true

# Enable gamification features
VITE_FEATURE_GAMIFICATION=true
